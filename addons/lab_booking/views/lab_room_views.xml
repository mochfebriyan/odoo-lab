<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lab_room_tree" model="ir.ui.view">
        <field name="name">lab.room.tree</field>
        <field name="model">lab.room</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="resource_type"/>
                <field name="capacity"/>
                <field name="location"/>
            </tree>
        </field>
    </record>

    <record id="view_lab_room_form" model="ir.ui.view">
        <field name="name">lab.room.form</field>
        <field name="model">lab.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bookings" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="booking_count" widget="statinfo" string="Peminjaman"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Arsip" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="mis. Lab Komputer 1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="resource_type"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="location"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Aturan pemakaian, SOP K3, dll."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lab_room_search" model="ir.ui.view">
        <field name="name">lab.room.search</field>
        <field name="model">lab.room</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="rooms" string="Ruang" domain="[('resource_type', '=', 'room')]"/>
                <filter name="equipments" string="Alat" domain="[('resource_type', '=', 'equipment')]"/>
                <separator/>
                <filter name="archived" string="Diarsipkan" domain="[('active', '=', False)]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="group_type" string="Jenis" context="{'group_by': 'resource_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lab_room" model="ir.actions.act_window">
        <field name="name">Ruang &amp; Alat</field>
        <field name="res_model">lab.room</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tambahkan ruang atau alat lab pertama</p>
        </field>
    </record>
</odoo>
